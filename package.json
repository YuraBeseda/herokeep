{
  "name": "herokeep",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm --filter web build",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "eslint . && pnpm --filter web lint && pnpm lint:styles",
    "lint:styles": "pnpm --filter web exec stylelint \"src/app/**/*.scss\" --allow-empty-input",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run && pnpm --filter api test:cloudflare && pnpm --filter web test --watch=false",
    "test:watch": "vitest",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "node scripts/dev.mjs",
    "dev:cf": "pnpm --filter api dev:cf"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
