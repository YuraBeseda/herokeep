{
  // Sibling of `src/adapters/cloudflare/tsconfig.json` (see that file's header comment for why a
  // separate program is required, not optional) — this one additionally needs
  // `@cloudflare/vitest-pool-workers`' own ambient types (the `cloudflare:test` virtual module:
  // `SELF`, `env`, `applyD1Migrations`, `runInDurableObject`, …) that only test files import.
  "extends": "../../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    "paths": { "@hk/protocol": ["../../../../../packages/protocol/src/index.ts"] }
  },
  "include": [
    "**/*.test.ts",
    "apply-migrations.ts",
    "typed-env.ts",
    "../../../src/adapters/cloudflare/**/*.ts",
    "../../../src/ports/**/*.ts",
    "../../../src/core/**/*.ts",
    "../../../../../packages/protocol/src/**/*.ts",
    "../../../wrangler.jsonc"
  ],
  // `vitest.config.ts` runs under plain Node (loading the pool plugin), not inside workerd — it
  // belongs to neither this program (workers-types' global `URL`/`Response`/etc. conflict with
  // `node:url`'s own types the moment this file imports `fileURLToPath`) nor the main
  // `apps/api/tsconfig.json` program (which excludes this whole directory). Left untyped by
  // design: vitest itself transpiles and runs it regardless of `tsc`'s opinion of it, and it has
  // no runtime-agnostic-core-style correctness obligation the way the adapter/test files do.
  "exclude": ["vitest.config.ts"]
}
