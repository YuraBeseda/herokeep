{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "herokeep-admin": "src/cli/admin.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/adapters/cloudflare/tsconfig.json --noEmit && tsc -p test/adapters/cloudflare/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cloudflare": "vitest run --config test/adapters/cloudflare/vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "dev:node": "node src/adapters/node/server.ts",
    "dev:cf": "wrangler dev",
    "admin": "node src/cli/admin.ts"
  },
  "dependencies": {
    "@hk/protocol": "workspace:*",
    "@hono/node-server": "2.1.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260919.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.10",
    "wrangler": "4.135.0"
  }
}
