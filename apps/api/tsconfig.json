{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "paths": { "@hk/protocol": ["../../packages/protocol/src/index.ts"] }
  },
  "include": ["src", "test", "vitest.config.ts", "drizzle.config.ts", "../../packages/protocol/src"],
  // `test/conformance/cloudflare.conformance.test.ts` imports `cloudflare:test` (workerd-only) —
  // excluded here for the same reason as `test/adapters/cloudflare` below (global type conflicts
  // between `@types/node` and `@cloudflare/workers-types`); it's covered instead by
  // `test/adapters/cloudflare/tsconfig.json`'s own `include`. Its siblings (`scenarios.ts`,
  // `frame-buffer.ts`, `node.conformance.test.ts`) stay covered by THIS program — they're plain,
  // adapter-agnostic TypeScript (same dual-program pattern `src/core/**`/`src/ports/**` already use).
  "exclude": ["src/adapters/cloudflare", "test/adapters/cloudflare", "test/conformance/cloudflare.conformance.test.ts"]
}
