{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "prestart": "pnpm --filter @hk/ui-tokens build:tokens",
    "start": "ng serve",
    "prebuild": "pnpm --filter @hk/ui-tokens build:tokens",
    "build": "ng build",
    "pretest": "pnpm --filter @hk/ui-tokens build:tokens",
    "test": "ng test",
    "lint": "ng lint && node scripts/check-i18n-keys.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:check": "node scripts/check-i18n-keys.mjs"
  },
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@jsverse/transloco": "~8.4.0",
    "@jsverse/transloco-messageformat": "~8.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.4.0",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco-keys-manager": "~8.1.1",
    "angular-eslint": "22.4.0",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "stylelint": "~17.15.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.68.0",
    "vitest": "^4.0.8"
  }
}
