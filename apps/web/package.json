{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "prestart": "pnpm --filter @hk/ui-tokens build:tokens && pnpm --filter @hk/content build:pack && node tools/copy-packs.ts",
    "start": "ng serve",
    "prebuild": "pnpm --filter @hk/ui-tokens build:tokens && pnpm --filter @hk/content build:pack && node tools/copy-packs.ts",
    "build": "ng build",
    "postbuild": "node tools/check-bundle-budget.ts",
    "pretest": "pnpm --filter @hk/ui-tokens build:tokens && pnpm --filter @hk/content build:pack && node tools/copy-packs.ts",
    "test": "ng test",
    "lint": "ng lint && node scripts/check-i18n-keys.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "build:sprite": "node tools/build-sprite.ts",
    "build:packs": "node tools/copy-packs.ts",
    "check:bundle-budget": "node tools/check-bundle-budget.ts",
    "pree2e": "pnpm run build",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@angular/cdk": "~22.1.5",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@jsverse/transloco": "~8.4.0",
    "@jsverse/transloco-messageformat": "~8.4.0",
    "dexie": "~4.4.5",
    "dompurify": "~3.4.15",
    "fflate": "0.8.3",
    "marked": "~18.0.11",
    "rxjs": "~7.8.0",
    "semver": "catalog:",
    "tslib": "^2.3.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.4.0",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco-keys-manager": "~8.1.1",
    "@playwright/test": "1.63.0",
    "@types/semver": "catalog:",
    "angular-eslint": "22.4.0",
    "eslint": "^10.9.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "serve": "14.2.6",
    "stylelint": "~17.15.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.68.0",
    "vitest": "^4.0.8"
  }
}
