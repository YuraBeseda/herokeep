{
  "name": "@hk/pack-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "herokeep-pack": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "@hk/engine": "workspace:*",
    "@hk/protocol": "workspace:*",
    "yaml": "catalog:"
  }
}
