  "notes": {
    "tA":  { "page": "foundations", "x": 0, "y": 0,    "text": "1 · Tavern Table v2 — the chosen concept with your four fixes", "kind": "title1", "maxW": 2400 },
    "tN":  { "page": "foundations", "x": 0, "y": 1813, "text": "2 · Navigation model and the action strap", "kind": "title1", "maxW": 2960 },
    "tH":  { "page": "foundations", "x": 0, "y": 3213, "text": "3 · Home screen and the phone drawer", "kind": "title1", "maxW": 2400 },
    "tT":  { "page": "foundations", "x": 0, "y": 4593, "text": "4 · The sheet on a tablet", "kind": "title1", "maxW": 1440 },
    "sA":  { "page": "foundations", "x": 1990, "y": 260,  "w": 360, "fill": "orange", "text": "Fixes applied: legends removed, every glyph explains itself on hover or long-press (three tooltips drawn open); concentration keeps the orb glyph (the eye was tried and rejected); spell slots are wax seals embossed with the level numeral; the javelin is a thrown spear; conditions carry a duration (Poisoned · 3 rounds shown expanded); features are grouped by source with level badges." },
    "sA2": { "page": "foundations", "x": 1990, "y": 700,  "w": 360, "fill": "green", "text": "Decided: the phone's fourth tab is \"Hero\" (abilities, saves, skills, proficiencies, features). Class colours stay off. Round advance is a DM control with a house rule that lets players clear their own conditions. Notes and roll log become drawers (see page 3)." },
    "sH":  { "page": "foundations", "x": 2460, "y": 3473, "w": 360, "fill": "orange", "text": "Home: Continue leaf for the last hero, a Tonight slip when a campaign session is live, heroes row, campaigns row, quick actions. On the phone the six sections live in the folio drawer (top-left button); home has no tab bar." },
    "sT":  { "page": "foundations", "x": 848,  "y": 4853, "w": 360, "fill": "orange", "text": "Tablet: folio stays as a column; the leaves split into two brass sub-tabs (Combat · Spells & bag) so nothing hides behind a long scroll." },

    "wT":  { "page": "wizard", "x": 0, "y": 0,    "text": "New hero wizard — desktop (en): vertical stepper, full-height pickers, description drawer, one Next", "kind": "title1", "maxW": 2960 },
    "wP":  { "page": "wizard", "x": 0, "y": 6344, "text": "Phone (uk): every step — compact step strip, bottom-sheet descriptions", "kind": "title1", "maxW": 4620 },
    "wTb": { "page": "wizard", "x": 0, "y": 7568, "text": "Tablet 768 (en): seal rail stepper, two-column picker, right drawer", "kind": "title1", "maxW": 1440 },
    "wS":  { "page": "wizard", "x": 3040, "y": 260, "w": 360, "fill": "orange", "text": "The hero built here is Maelis Thorne (Elf · Soldier · Fighter; W08 shows a Cleric's spell step). Done steps carry a wax seal; the class-choice steps appear once a class is chosen. Gated cards keep their reason on hover. Nothing auto-advances." },

    "sT1": { "page": "sheet", "x": 0, "y": 0,    "text": "Build, Timeline, Level up (shared stepper and strap), the three drawers, every sheet dialog", "kind": "title1", "maxW": 2960 },
    "sP":  { "page": "sheet", "x": 0, "y": 8971, "text": "Phone (uk): Build and Timeline under More, the Hero tab, level-up, every drawer and dialog as a sheet", "kind": "title1", "maxW": 3680 },
    "sS":  { "page": "sheet", "x": 3040, "y": 4491, "w": 360, "fill": "blue", "text": "Your call 4: notes and the roll log as drawers (D01, D02) instead of inline sections. The description drawer (D03) is the same pattern for every entity. Say if a drawer should become a tab instead." },
    "sS2": { "page": "sheet", "x": 3040, "y": 1760, "w": 360, "fill": "orange", "text": "L03 is drawn at Paladin 7 → 8 because level 6 has no choice step; L01, L02 and L04 are 5 → 6. Revert is \"Відкотити\", Cancel stays \"Скасувати\"." },

    "cT":  { "page": "campaigns", "x": 0, "y": 0,    "text": "Campaigns — list, join, link, lobby, party (DM and player), member sheet, table, settings, confirms", "kind": "title1", "maxW": 2960 },
    "cP":  { "page": "campaigns", "x": 0, "y": 7536, "text": "Phone (uk): every campaign screen, encounter plate on party and table", "kind": "title1", "maxW": 2740 },
    "cTb": { "page": "campaigns", "x": 0, "y": 9684, "text": "Tablet 768 (en): party (DM) with the quick-effects sheet", "kind": "title1", "maxW": 1440 },
    "cS":  { "page": "campaigns", "x": 3040, "y": 2420, "w": 360, "fill": "orange", "text": "Round advance lives on the Party leaf header and the Table's session strip; C10 holds the house rule \"Players manage their own conditions\". The DM cannot leave (Delete is the destructive verb); campaign settings autosave." },

    "lT":  { "page": "library", "x": 0, "y": 0,    "text": "Library, packs and homebrew, heroes list, settings, auth, system states", "kind": "title1", "maxW": 2960 },
    "lP":  { "page": "library", "x": 0, "y": 7744, "text": "Phone (uk): library entries, packs, homebrew, heroes, settings, auth, states", "kind": "title1", "maxW": 2740 },
    "lTb": { "page": "library", "x": 0, "y": 9892, "text": "Tablet 768 (en): library and home", "kind": "title1", "maxW": 1616 },
    "xT":  { "page": "later", "x": 0, "y": 0, "text": "6 · Later ideas — sketches, not commitments; each sticky says what it would need", "kind": "title1", "maxW": 2320 },
    "xS":  { "page": "later", "x": 2400, "y": 260, "w": 360, "fill": "purple", "text": "What each would need: encounter board, death saves, print, 3D dice, the three DnD themes = UI only. Journal = campaign events. Loot and shop = campaign events + a little engine (coin change). Companion and Wild Shape = engine + protocol + a creature entity type in the pack format (the SRD pack has no stat blocks). Other-game theme packs = a theme pack kind." },
    "xS2": { "page": "later", "x": 2400, "y": 1280, "w": 360, "fill": "orange", "text": "Wild Shape is drawn with the 2024 reading: your HP is kept, the form grants temporary HP, and dropping to 0 ends the form. The druid is level 8 so a CR 1 Brown Bear is legal. Creature numbers come from SRD 5.1 stat blocks." },
    "lS":  { "page": "library", "x": 3040, "y": 5264, "w": 360, "fill": "orange", "text": "About folds into Settings. Auth forms carry their primary button in their own leather strap (page strap keeps Back and Help) — say if you prefer the page strap. Theme cards preview tavern, scroll and plain." }
  },
  "designSystems": []
}
